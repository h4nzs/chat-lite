---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
import '../index.css';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import { FiHash, FiRefreshCcw, FiShield, FiMail } from 'react-icons/fi';

const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = useTranslations(lang);

const title = t('refund:meta.title') !== 'refund:meta.title' ? t('refund:meta.title') : 'Refund Policy | NYX Chat';
const description = t('refund:meta.description') !== 'refund:meta.description' ? t('refund:meta.description') : 'Refund policy for NYX Pro cryptocurrency payments.';
const homeLabel = t('common:home') !== 'common:home' ? t('common:home') : 'Home';
const navRefund = t('common:nav.refund') !== 'common:nav.refund' ? t('common:nav.refund') : 'Refund Policy';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "NYX Project",
    "logo": "https://nyx-app.my.id/pwa-192x192.png"
  }
});

const sections = [
  { icon: FiHash, title: t('refund:payments_title'), desc: t('refund:payments_desc'), raw: false },
  { icon: FiRefreshCcw, title: t('refund:refund_title'), desc: t('refund:refund_desc'), raw: false },
  { icon: FiShield, title: t('refund:zk_title'), desc: t('refund:zk_desc'), raw: false },
  { icon: FiMail, title: t('refund:how_to_claim_title'), desc: t('refund:how_to_claim_desc'), raw: true },
];
---

<MainLayout title={title} description={description} canonicalUrl={Astro.url.pathname} schemaMarkup={schema}>
  <div class="min-h-screen bg-bg-main text-text-primary relative overflow-x-clip">
    <div class="aurora-blob w-[480px] h-[480px] -top-40 -right-40" style="background: radial-gradient(circle, hsl(var(--grad-end) / 0.10), transparent 60%);"></div>
    <div class="aurora-blob w-[420px] h-[420px] top-1/2 -left-44" style="background: radial-gradient(circle, hsl(var(--grad-start) / 0.10), transparent 60%);"></div>

    <main class="max-w-4xl mx-auto px-6 py-10 md:py-14 relative">

      <nav class="flex items-center gap-2 text-xs font-bold text-text-secondary uppercase tracking-widest mb-12 animate-in fade-in duration-500">
        <a href={lang === 'en' ? '/' : langPrefix} class="hover:text-accent transition-colors">{homeLabel}</a>
        <span class="text-text-secondary/40">/</span>
        <span class="text-accent">{navRefund}</span>
      </nav>

      <header class="text-center mb-16 animate-in slide-in-from-bottom-4 duration-700">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
          <FiRefreshCcw size={14} /> {t('refund:title')}
        </div>
        <h1 class="font-display font-black text-4xl md:text-5xl leading-[1.05] tracking-tight mb-5">
          {t('refund:title')}
        </h1>
        <p class="text-text-secondary text-sm font-mono opacity-60">
          {t('refund:last_updated')}
        </p>
      </header>

      <p class="text-lg text-text-secondary leading-relaxed mb-10">
        {t('refund:intro')}
      </p>

      <div class="space-y-8">
        {sections.map((item) => {
          const Icon = item.icon;
          return (
            <section class="card-neumorphic">
              <div class="flex items-center gap-4 mb-4">
                <div class="icon-well w-12 h-12 flex-shrink-0"><Icon size={22} /></div>
                <h2 class="font-display text-xl md:text-2xl font-bold tracking-tight">{item.title}</h2>
              </div>
              {item.raw ? (
                <p class="text-text-secondary leading-relaxed" set:html={item.desc}></p>
              ) : (
                <p class="text-text-secondary leading-relaxed">{item.desc}</p>
              )}
            </section>
          );
        })}
      </div>

      <div class="mt-24">
        <Footer lang={lang} />
      </div>
    </main>
  </div>
</MainLayout>
