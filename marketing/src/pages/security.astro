---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
import '../index.css';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import EncryptedFlow from '../components/EncryptedFlow';
import BlindRelay from '../components/BlindRelay';
import StatStrip from '../components/StatStrip';
import PqKeyExchange from '../components/PqKeyExchange';
import BurnerFlow from '../components/BurnerFlow';
import {
  FiShield, FiLock, FiDatabase, FiHash, FiRefreshCw, FiAlertTriangle,
  FiFileText, FiHardDrive, FiDownload, FiCloudOff, FiServer, FiRadio,
  FiUserCheck, FiPhone, FiCheck, FiX, FiUser, FiArrowRight, FiUserPlus
} from 'react-icons/fi';

const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = useTranslations(lang);

const title = t('security:meta.title') !== 'security:meta.title' ? t('security:meta.title') : 'Security Architecture | NYX Chat';
const description = t('security:meta.description') !== 'security:meta.description' ? t('security:meta.description') : 'The zero-knowledge, post-quantum architecture of NYX.';
const homeLabel = t('common:home') !== 'common:home' ? t('common:home') : 'Home';
const navSecurity = 'Security';

const securitySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "NYX Security Architecture & Zero-Knowledge Protocol",
  "alternativeHeadline": "How NYX protects metadata without storing user identities",
  "author": { "@type": "Organization", "name": "NYX Project" },
  "keywords": "PQX3DH, ML-KEM-768, X-Wing, Argon2id, Zero-Knowledge, End-to-End Encryption, WebTransport",
  "articleBody": "NYX takes a radical approach to security: Trust No One (TNO). PQX3DH hybrid key exchange, Double Ratchet, blind relay, and an encrypted local vault.",
  "datePublished": "2026-03-01"
});

const statsItems = [
  { label: t('security:stats.stat_1_label'), value: t('security:stats.stat_1_value') + t('security:stats.stat_1_suffix') },
  { label: t('security:stats.stat_2_label'), value: t('security:stats.stat_2_value') + t('security:stats.stat_2_suffix') },
  { label: t('security:stats.stat_3_label'), value: t('security:stats.stat_3_value') + t('security:stats.stat_3_suffix') },
  { label: t('security:stats.stat_4_label'), value: t('security:stats.stat_4_value') + t('security:stats.stat_4_suffix') },
];
---

<MainLayout title={title} description={description} canonicalUrl={Astro.url.pathname} schemaMarkup={securitySchema}>
  <div class="min-h-screen bg-bg-main text-text-primary relative overflow-x-clip">
    <div class="aurora-blob w-[560px] h-[560px] -top-40 -right-40" style="background: radial-gradient(circle, hsl(var(--grad-end) / 0.10), transparent 60%);"></div>
    <div class="aurora-blob w-[480px] h-[480px] top-1/2 -left-44" style="background: radial-gradient(circle, hsl(var(--grad-start) / 0.10), transparent 60%);"></div>

    <main class="max-w-6xl mx-auto px-6 py-10 md:py-14 relative">

      <nav class="flex items-center gap-2 text-xs font-bold text-text-secondary uppercase tracking-widest mb-12 animate-in fade-in duration-500">
        <a href={lang === 'en' ? '/' : langPrefix} class="hover:text-accent transition-colors">{homeLabel}</a>
        <span class="text-text-secondary/40">/</span>
        <span class="text-accent">{navSecurity}</span>
      </nav>

      <!-- HERO -->
      <header class="text-center mb-20 animate-in slide-in-from-bottom-4 duration-700">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
          <FiShield size={14} /> ZERO-KNOWLEDGE · POST-QUANTUM
        </div>
        <h1 class="font-display font-black text-4xl md:text-6xl leading-[1.02] tracking-tight mb-6">{t('security:hero.title')}</h1>
        <p class="sr-only">{t('security:seo.geo_hook')}</p>
        <p class="text-lg md:text-xl text-text-secondary max-w-3xl mx-auto leading-relaxed">{t('security:hero.subtitle')}</p>
      </header>

      <!-- 01 THREAT MODEL -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-red-500 bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:threat.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:threat.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:threat.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed" set:html={t('security:threat.p2')}></p>
          </div>
          <div class="card-neumorphic-flat p-6 font-mono relative overflow-hidden">
            <div class="flex items-center justify-between mb-5 text-xs border-b border-text-secondary/10 pb-4">
              <span class="text-text-secondary/70">{t('security:threat.visual_title')}</span>
              <span class="text-red-500 font-bold flex items-center gap-2">
                <FiAlertTriangle size={14} /> {t('security:threat.visual_status')}
              </span>
            </div>
            <div class="space-y-3 text-xs">
              {['e2a9f8b3…', '7c4d11a9…', 'ff20x91p…'].map((row, i) => (
                <div key={i} class="flex gap-4">
                  <span class="text-accent w-12 flex-shrink-0">ROW_{i + 1}</span>
                  <span class="text-text-secondary/50 truncate">{row} <span class="text-red-400/60">[{t('security:threat.visual_row')}]</span></span>
                </div>
              ))}
            </div>
            <div class="absolute inset-0 flex items-center justify-center bg-bg-surface/70 backdrop-blur-[2px] rounded-2xl">
              <div class="card-neumorphic-flat px-6 py-4 rounded-2xl flex items-center gap-4">
                <FiShield class="text-green-500 flex-shrink-0" size={28} />
                <div class="text-left">
                  <div class="font-bold text-sm text-text-primary">{t('security:threat.visual_secured')}</div>
                  <div class="text-green-500 text-xs">{t('security:threat.visual_zk')}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 BLIND INDEXING -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="lg:order-2">
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:blind.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:blind.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:blind.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:blind.p2')}></p>
            <p class="text-text-secondary text-lg leading-relaxed">{t('security:blind.p3')}</p>
          </div>
          <div class="lg:order-1 card-neumorphic-flat p-8">
            <div class="flex flex-col md:flex-row items-center justify-center gap-5">
              <div class="flex flex-col items-center gap-3">
                <div class="icon-well w-16 h-16"><FiUser size={28} /></div>
                <div class="text-xs font-mono text-text-secondary text-center"><span class="text-text-primary font-bold">@{'h4nzs'}</span><br />{t('security:blind.visual_device')}</div>
              </div>
              <div class="flex flex-col md:flex-row items-center gap-3">
                <FiArrowRight class="text-accent hidden md:block" size={20} />
                <div class="icon-well w-14 h-14 text-accent"><FiHash size={24} /></div>
                <FiArrowRight class="text-accent hidden md:block" size={20} />
              </div>
              <div class="flex flex-col items-center gap-3">
                <div class="icon-well w-16 h-16"><FiDatabase size={26} /></div>
                <div class="text-xs font-mono text-text-secondary text-center"><span class="text-text-primary font-bold">{t('security:blind.visual_server')}</span><br />{t('security:blind.visual_hash')}</div>
              </div>
            </div>
            <p class="mt-6 text-center text-xs font-bold text-accent font-mono uppercase tracking-widest">{t('security:blind.visual_kdf')} · 64 MB</p>
          </div>
        </div>
      </section>

      <!-- 03 PQX3DH -->
      <section class="py-16 md:py-20">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:pq.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:pq.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto mb-4" set:html={t('security:pq.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto" set:html={t('security:pq.p2')}></p>
          </div>
          <PqKeyExchange
            step1Title={t('security:pq.visual.step_1_title')}
            step1Desc={t('security:pq.visual.step_1_desc')}
            step2Title={t('security:pq.visual.step_2_title')}
            step2Desc={t('security:pq.visual.step_2_desc')}
            step3Title={t('security:pq.visual.step_3_title')}
            step3Desc={t('security:pq.visual.step_3_desc')}
            note={t('security:pq.visual.note')}
            client:load
          />
        </div>
      </section>

      <!-- 04 DOUBLE RATCHET -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:ratchet.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:ratchet.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:ratchet.p1')}></p>
            <ul class="space-y-4 text-text-secondary text-lg">
              <li class="flex items-start gap-4">
                <FiShield class="text-accent mt-1 flex-shrink-0" size={24} />
                <div set:html={t('security:ratchet.pfs')}></div>
              </li>
              <li class="flex items-start gap-4">
                <FiRefreshCw class="text-accent mt-1 flex-shrink-0" size={24} />
                <div set:html={t('security:ratchet.pcs')}></div>
              </li>
            </ul>
          </div>
          <div class="card-neumorphic-flat p-8 flex flex-col items-center">
            <div class="flex items-center gap-6 mb-8">
              <div class="icon-well w-16 h-16 animate-[spin_6s_linear_infinite]"><FiRefreshCw size={26} /></div>
              <div class="flex flex-col gap-2 w-48">
                {['KEY_A', 'KEY_B', 'KEY_C'].map((key, i) => (
                  <div key={key} class={`bg-bg-main rounded-lg px-3 py-2 text-[11px] font-mono flex justify-between items-center ${i === 0 ? '' : i === 1 ? 'opacity-75' : 'opacity-50'}`} style="box-shadow: var(--shadow-neu-pressed)">
                    <span class="text-text-secondary">{t('security:ratchet.visual_msg')} #{i + 1}</span>
                    <span class="text-accent font-bold">{key}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="w-full bg-bg-main rounded-xl px-4 py-3 text-xs text-center font-mono text-text-secondary" style="box-shadow: var(--shadow-neu-pressed)">
              Plaintext → <span class="text-text-primary font-bold">v2_28a9b1…c4</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 MESSAGE PIPELINE (reuse EncryptedFlow) -->
      <EncryptedFlow
        title={t('security:pipeline_badge')}
        headline={t('landing:pipeline.headline')}
        subtitle={t('landing:pipeline.subtitle')}
        sender={t('landing:pipeline.sender')}
        server={t('landing:pipeline.server')}
        recipient={t('landing:pipeline.recipient')}
        step1={t('landing:pipeline.step_1')}
        step2={t('landing:pipeline.step_2')}
        step3={t('landing:pipeline.step_3')}
        proof1={t('landing:pipeline.proof_1')}
        proof2={t('landing:pipeline.proof_2')}
        proof3={t('landing:pipeline.proof_3')}
        client:load
      />

      <!-- 06 BLIND RELAY (reuse BlindRelay) -->
      <BlindRelay
        title={t('security:blindrelay_badge')}
        headline={t('landing:blind.headline')}
        subtitle={t('landing:blind.subtitle')}
        senderLabel={t('landing:blind.sender_label')}
        serverLabel={t('landing:blind.server_label')}
        recipientLabel={t('landing:blind.recipient_label')}
        fromUnknown={t('landing:blind.from_unknown')}
        toLabel={t('landing:blind.to_label')}
        serverNote={t('landing:blind.server_note')}
        burnerNote={t('landing:blind.burner_note')}
        client:load
      />

      <!-- STATS -->
      <StatStrip
        title={t('security:stats.title')}
        headline={t('security:stats.headline')}
        items={statsItems}
        client:load
      />

      <!-- 07 BURNER SESSIONS -->
      <section class="py-16 md:py-20">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:burner.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:burner.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto mb-4" set:html={t('security:burner.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto" set:html={t('security:burner.p2')}></p>
          </div>
          <BurnerFlow
            step1Title={t('security:burner.visual.step_1_title')}
            step1Desc={t('security:burner.visual.step_1_desc')}
            step2Title={t('security:burner.visual.step_2_title')}
            step2Desc={t('security:burner.visual.step_2_desc')}
            step3Title={t('security:burner.visual.step_3_title')}
            step3Desc={t('security:burner.visual.step_3_desc')}
            step4Title={t('security:burner.visual.step_4_title')}
            step4Desc={t('security:burner.visual.step_4_desc')}
            note={t('security:burner.visual.note')}
            client:load
          />
        </div>
      </section>

      <!-- 08 FILE ENCRYPTION -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:file.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:file.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:file.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed" set:html={t('security:file.p2')}></p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-stretch">
            <div class="card-neumorphic-flat p-5 text-center">
              <div class="icon-well w-12 h-12 mx-auto mb-3"><FiFileText size={22} /></div>
              <p class="text-xs font-bold text-text-primary mb-1">{t('security:file.visual_device')}</p>
              <p class="text-[10px] text-accent font-mono uppercase tracking-wider leading-relaxed">{t('security:file.visual_encrypt')}</p>
            </div>
            <div class="flex items-center justify-center"><FiArrowRight class="text-accent" size={20} /></div>
            <div class="card-neumorphic-flat p-5 text-center">
              <div class="icon-well w-12 h-12 mx-auto mb-3"><FiHardDrive size={22} /></div>
              <p class="text-xs font-bold text-text-primary mb-1">{t('security:file.visual_r2')}</p>
              <p class="text-[10px] text-text-secondary font-mono uppercase tracking-wider">⚿ blob</p>
            </div>
            <div class="flex items-center justify-center sm:hidden"><FiArrowRight class="text-accent rotate-90" size={20} /></div>
            <div class="hidden sm:flex items-center justify-center"><FiArrowRight class="text-accent" size={20} /></div>
            <div class="card-neumorphic-flat p-5 text-center">
              <div class="icon-well w-12 h-12 mx-auto mb-3"><FiDownload size={22} /></div>
              <p class="text-xs font-bold text-text-primary mb-1">{t('security:file.visual_recipient')}</p>
              <p class="text-[10px] text-accent font-mono uppercase tracking-wider leading-relaxed">{t('security:file.visual_decrypt')}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 09 LOCAL VAULT -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="lg:order-2">
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:vault.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:vault.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:vault.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed" set:html={t('security:vault.p2')}></p>
          </div>
          <div class="lg:order-1 flex items-center justify-center gap-6">
            <div class="card-neumorphic-flat p-6 text-center">
              <div class="icon-well w-14 h-14 mx-auto mb-4"><FiDatabase size={26} /></div>
              <p class="text-xs font-mono text-accent font-bold">{t('security:vault.visual_vault')}</p>
              <p class="mt-2 text-[10px] text-text-secondary font-mono uppercase tracking-wider">{t('security:vault.visual_encrypted')}</p>
            </div>
            <div class="flex flex-col items-center gap-2">
              <FiX class="text-red-500" size={24} />
              <span class="text-[10px] font-mono text-red-500/80 uppercase tracking-wider">✗ no sync</span>
            </div>
            <div class="card-neumorphic-flat p-6 text-center opacity-70">
              <div class="icon-well w-14 h-14 mx-auto mb-4"><FiCloudOff size={26} /></div>
              <p class="text-xs font-mono text-text-secondary font-bold">{t('security:vault.visual_cloud')}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 10 TRANSPORT -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:transport.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:transport.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed mb-5" set:html={t('security:transport.p1')}></p>
            <p class="text-text-secondary text-lg leading-relaxed" set:html={t('security:transport.p2')}></p>
          </div>
          <div class="card-neumorphic-flat p-6">
            <div class="relative space-y-0">
              {[
                { icon: FiRadio, label: t('security:transport.visual_app') },
                { icon: FiServer, label: t('security:transport.visual_wt') },
                { icon: FiLock, label: t('security:transport.visual_sidecar') },
                { icon: FiRefreshCw, label: t('security:transport.visual_redis') },
                { icon: FiDatabase, label: t('security:transport.visual_node') },
              ].map((layer, i) => (
                <div key={i}>
                  <div class="flex items-center gap-3 bg-bg-main rounded-xl px-4 py-3" style="box-shadow: var(--shadow-neu-pressed)">
                    <layer.icon class="text-accent flex-shrink-0" size={18} />
                    <span class="text-sm font-bold text-text-primary">{layer.label}</span>
                  </div>
                  {i < 4 && (
                    <div class="relative h-5 flex items-center justify-center">
                      <div class="absolute w-0.5 h-full bg-accent/40"></div>
                      <div class="absolute w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
                    </div>
                  )}
                </div>
              ))}
            </div>
            <p class="mt-5 pt-4 border-t border-text-secondary/10 text-center text-[10px] font-mono text-text-secondary uppercase tracking-widest">
              {t('security:transport.visual_chaff')}
            </p>
          </div>
        </div>
      </section>

      <!-- 11 TRUST TIER -->
      <section class="py-16 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="lg:order-2">
            <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
              {t('security:tier.badge')}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:tier.title')}</h2>
            <p class="text-text-secondary text-lg leading-relaxed" set:html={t('security:tier.p1')}></p>
          </div>
          <div class="lg:order-1 card-neumorphic-flat p-8">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
              <div class="flex flex-col items-center gap-3">
                <div class="icon-well w-16 h-16"><FiUserCheck size={26} /></div>
                <p class="text-xs font-mono font-bold text-text-primary">{t('security:tier.visual_sandbox')}</p>
              </div>
              <div class="flex flex-col items-center gap-2">
                <div class="card-neumorphic-flat px-3 py-1 rounded-full text-[10px] font-mono text-accent uppercase tracking-wider">{t('security:tier.visual_webauthn')}</div>
                <FiArrowRight class="text-accent" size={22} />
                <div class="card-neumorphic-flat px-3 py-1 rounded-full text-[10px] font-mono text-accent uppercase tracking-wider">{t('security:tier.visual_pow')}</div>
              </div>
              <div class="flex flex-col items-center gap-3">
                <div class="icon-well w-16 h-16 text-accent" style="box-shadow: var(--shadow-neu-flat)"><FiShield size={26} /></div>
                <p class="text-xs font-mono font-bold text-accent">{t('security:tier.visual_vip')}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 12 CALLS -->
      <section class="py-16 md:py-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block px-4 py-1.5 mb-5 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
            {t('security:calls.badge')}
          </div>
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 leading-tight tracking-tight">{t('security:calls.title')}</h2>
          <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto mb-4" set:html={t('security:calls.p1')}></p>
          <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mx-auto">{t('security:calls.p2')}</p>
          <div class="mt-8 flex items-center justify-center gap-8">
            <div class="flex flex-col items-center gap-2">
              <div class="icon-well w-14 h-14"><FiPhone size={24} /></div>
              <span class="text-xs font-mono text-text-secondary">Peer A</span>
            </div>
            <div class="w-24 h-0.5 bg-accent/40 relative overflow-hidden rounded-full">
              <div class="absolute top-0 left-0 w-1/3 h-full bg-accent animate-[webrtcFlow_2s_linear_infinite]"></div>
            </div>
            <div class="flex flex-col items-center gap-2">
              <div class="icon-well w-14 h-14"><FiPhone size={24} /></div>
              <span class="text-xs font-mono text-text-secondary">Peer B</span>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-16 md:py-24">
        <div class="max-w-5xl mx-auto">
          <div class="relative rounded-[2.5rem] p-10 md:p-16 text-center overflow-hidden bg-bg-surface" style="box-shadow: var(--shadow-neu-float)">
            <div class="aurora-blob w-96 h-96 -top-32 -left-24" style="background: radial-gradient(circle, hsl(var(--grad-start) / 0.25), transparent 60%);"></div>
            <div class="aurora-blob w-96 h-96 -bottom-32 -right-24" style="background: radial-gradient(circle, hsl(var(--grad-end) / 0.22), transparent 60%);"></div>
            <div class="relative">
              <h2 class="font-display font-black text-3xl md:text-5xl leading-tight tracking-tight mb-5">{t('security:cta.title')}</h2>
              <p class="text-lg text-text-secondary mb-10 max-w-2xl mx-auto leading-relaxed">{t('security:cta.subtitle')}</p>
              <a href="https://github.com/h4nzs/nyx-chat/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="btn-primary px-10 py-4 text-lg inline-flex">
                <FiShield className="mr-2" /> {t('security:cta.button')}
              </a>
            </div>
          </div>
        </div>
      </section>

      <div class="mt-16">
        <Footer lang={lang} />
      </div>
    </main>
  </div>
</MainLayout>

<style>
  @keyframes webrtcFlow {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(300%); }
  }
</style>
