---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
import '../index.css';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import {
  FiShield, FiLock, FiTerminal, FiMail, FiCheck, FiX, FiAlertTriangle,
  FiChevronDown, FiActivity, FiTrendingUp, FiGlobe, FiRefreshCw, FiServer, FiChevronLeft
} from 'react-icons/fi';

const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = useTranslations(lang);

const title = t('commercial:meta.title');
const description = t('commercial:meta.description');
const homeLabel = t('common:home') !== 'common:home' ? t('common:home') : 'Home';
const navCommercial = t('common:nav.commercial') !== 'common:nav.commercial' ? t('common:nav.commercial') : 'Commercial';

const licenseSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "NYX Project",
    "logo": "https://nyx-app.my.id/pwa-192x192.png"
  }
});

const compareRows = [
  { feature: t('commercial:compare.f1'), agpl: { check: true }, com: { check: true } },
  { feature: t('commercial:compare.f2'), agpl: { text: t('commercial:compare.val_agpl_f2'), danger: true }, com: { text: t('commercial:compare.val_com_f2'), bold: true } },
  { feature: t('commercial:compare.f3'), agpl: { x: true }, com: { check: true } },
  { feature: t('commercial:compare.f5'), agpl: { text: t('commercial:compare.val_agpl_f5'), muted: true }, com: { text: t('commercial:compare.val_com_f5'), bold: true } },
];

const useCases = [
  { icon: FiActivity, title: t('commercial:usecases.c1_title'), desc: t('commercial:usecases.c1_desc'), tone: 'text-accent' },
  { icon: FiTrendingUp, title: t('commercial:usecases.c2_title'), desc: t('commercial:usecases.c2_desc'), tone: 'text-[hsl(180_95%_33%)] dark:text-[hsl(180_95%_55%)]' },
  { icon: FiGlobe, title: t('commercial:usecases.c3_title'), desc: t('commercial:usecases.c3_desc'), tone: 'text-[hsl(263_100%_40%)] dark:text-[hsl(263_100%_66%)]' },
];

const faqItems = [
  { icon: FiShield, title: t('commercial:faq.q1'), desc: t('commercial:faq.a1') },
  { icon: FiRefreshCw, title: t('commercial:faq.q2'), desc: t('commercial:faq.a2') },
  { icon: FiServer, title: t('commercial:faq.q3'), desc: t('commercial:faq.a3') },
];
---

<MainLayout title={title} description={description} canonicalUrl={Astro.url.pathname} schemaMarkup={licenseSchema}>
  <div class="min-h-screen bg-bg-main text-text-primary relative overflow-x-clip">
    <div class="aurora-blob w-[520px] h-[520px] -top-40 -right-40" style="background: radial-gradient(circle, hsl(var(--grad-end) / 0.10), transparent 60%);"></div>
    <div class="aurora-blob w-[460px] h-[460px] top-1/3 -left-44" style="background: radial-gradient(circle, hsl(var(--grad-start) / 0.10), transparent 60%);"></div>

    <main class="max-w-5xl mx-auto px-6 py-10 md:py-14 relative">

      <nav class="flex items-center gap-2 text-xs font-bold text-text-secondary uppercase tracking-widest mb-12 animate-in fade-in duration-500">
        <a href={lang === 'en' ? '/' : langPrefix} class="hover:text-accent transition-colors">{homeLabel}</a>
        <span class="text-text-secondary/40">/</span>
        <span class="text-accent">{navCommercial}</span>
      </nav>

      <!-- Hero -->
      <header class="text-center mb-20 animate-in slide-in-from-bottom-4 duration-700">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-xs font-bold text-accent bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
          <FiShield size={14} /> {t('commercial:hero.badge')}
        </div>
        <h1 class="font-display font-black text-4xl md:text-6xl leading-[1.02] tracking-tight mb-6">
          {t('commercial:hero.title')}
        </h1>
        <p class="text-lg md:text-xl text-text-secondary max-w-3xl mx-auto leading-relaxed">
          {t('commercial:hero.subtitle')}
        </p>
      </header>

      <!-- AGPL + Commercial cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-24">
        <section class="card-neumorphic relative overflow-hidden">
          <div class="absolute top-0 left-0 w-1 h-full bg-accent/60"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiLock size={22} /></div>
            <div>
              <div class="text-[10px] text-text-secondary font-mono tracking-widest uppercase opacity-60">{t('commercial:agpl.badge')}</div>
              <h2 class="font-display text-2xl font-bold tracking-tight">{t('commercial:agpl.title')}</h2>
            </div>
          </div>
          <div class="space-y-4 text-text-secondary leading-relaxed">
            <p set:html={t('commercial:agpl.p1')}></p>
            <p set:html={t('commercial:agpl.p2')}></p>

            <div class="mt-8 p-5 bg-red-500/5 border border-red-500/15 rounded-2xl">
              <h3 class="text-red-500 font-bold flex items-center gap-2 mb-2 text-sm uppercase tracking-wide">
                <FiAlertTriangle /> {t('commercial:agpl.warning_title')}
              </h3>
              <p class="text-xs text-red-600/80 dark:text-red-400/80 leading-relaxed">{t('commercial:agpl.warning_desc')}</p>
            </div>
          </div>
        </section>

        <section class="card-neumorphic relative overflow-hidden">
          <div class="absolute top-0 right-0 w-1 h-full bg-accent/60"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiTerminal size={22} /></div>
            <div>
              <div class="text-[10px] text-accent font-mono tracking-widest uppercase">{t('commercial:hero.badge')}</div>
              <h2 class="font-display text-2xl font-bold tracking-tight">{t('commercial:hero.enterprise')}</h2>
            </div>
          </div>
          <div class="space-y-6">
            <p class="text-text-secondary leading-relaxed">
              {t('commercial:compare.col2_desc')}
            </p>
            <ul class="space-y-3">
              <li class="flex items-center gap-3 text-sm font-medium">
                <FiCheck className="text-accent flex-shrink-0" /> {t('commercial:compare.f1')}
              </li>
              <li class="flex items-center gap-3 text-sm font-medium">
                <FiCheck className="text-accent flex-shrink-0" /> {t('commercial:compare.f3')}
              </li>
              <li class="flex items-center gap-3 text-sm font-medium">
                <FiCheck className="text-accent flex-shrink-0" /> {t('commercial:compare.f4')}
              </li>
              <li class="flex items-center gap-3 text-sm font-medium text-accent">
                <FiCheck className="flex-shrink-0" /> {t('commercial:compare.val_com_f2')}
              </li>
            </ul>
            <a href="mailto:support@nyx-app.my.id" class="btn-primary w-full py-4">
              <FiMail className="mr-2" /> {t('commercial:cta.button')}
            </a>
          </div>
        </section>
      </div>

      <!-- Comparison Table -->
      <section class="mb-24">
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-1.5 mb-4 text-[10px] font-bold text-text-secondary bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
            {t('commercial:compare.badge')}
          </div>
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">{t('commercial:compare.title')}</h2>
        </div>

        <div class="card-neumorphic p-2 md:p-4 overflow-x-auto">
          <table class="w-full text-left border-separate border-spacing-y-2 md:border-spacing-y-3">
            <thead>
              <tr class="text-xs uppercase tracking-widest">
                <th class="py-3 px-5 text-text-secondary font-bold">{t('commercial:compare.feature')}</th>
                <th class="py-3 px-5 font-bold text-text-primary">{t('commercial:compare.col1_title')}</th>
                <th class="py-3 px-5 font-bold text-accent">{t('commercial:compare.col2_title')}</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              {compareRows.map((row) => (
                <tr class="hover:-translate-y-0.5 transition-transform duration-300">
                  <td class="py-4 px-5 font-medium bg-bg-main rounded-l-2xl" style="box-shadow: var(--shadow-neu-icon)">{row.feature}</td>
                  <td class="py-4 px-5 bg-bg-main" style="box-shadow: var(--shadow-neu-icon)">
                    {row.agpl.check && <FiCheck className="text-accent" />}
                    {row.agpl.x && <FiX className="text-text-secondary opacity-30" />}
                    {row.agpl.text && (
                      <span class={row.agpl.danger ? 'text-red-500/80 font-medium' : row.agpl.muted ? 'text-text-secondary opacity-50' : 'text-text-secondary'}>{row.agpl.text}</span>
                    )}
                  </td>
                  <td class="py-4 px-5 bg-bg-main rounded-r-2xl" style="box-shadow: var(--shadow-neu-icon)">
                    {row.com.check && <FiCheck className="text-accent" />}
                    {row.com.text && <span class={row.com.bold ? 'text-accent font-bold' : 'text-text-secondary'}>{row.com.text}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Use Cases -->
      <section class="mb-24">
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-1.5 mb-4 text-[10px] font-bold text-text-secondary bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
            {t('commercial:usecases.badge')}
          </div>
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">{t('commercial:usecases.title')}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {useCases.map((item) => {
            const Icon = item.icon;
            return (
              <div class="card-neumorphic">
                <div class="icon-well w-12 h-12 mb-4"><Icon size={22} /></div>
                <h3 class={`font-display text-xl font-bold mb-3 ${item.tone}`}>{item.title}</h3>
                <p class="text-sm text-text-secondary leading-relaxed">{item.desc}</p>
              </div>
            );
          })}
        </div>
      </section>

      <!-- FAQ -->
      <section class="mb-24">
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-1.5 mb-4 text-[10px] font-bold text-text-secondary bg-bg-surface rounded-full tracking-widest uppercase" style="box-shadow: var(--shadow-neu-icon)">
            {t('commercial:faq.badge')}
          </div>
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">{t('commercial:faq.title')}</h2>
        </div>
        <div class="space-y-4 max-w-3xl mx-auto">
          {faqItems.map((item) => {
            const Icon = item.icon;
            return (
              <div class="card-neumorphic-flat p-0 overflow-hidden">
                <details class="group">
                  <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-text-primary hover:text-accent transition-colors gap-4">
                    <span class="flex items-center gap-3">
                      <span class="icon-well w-9 h-9 flex-shrink-0 text-accent"><Icon size={18} /></span>
                      <span class="font-display text-lg">{item.title}</span>
                    </span>
                    <span class="transition group-open:rotate-180 text-accent flex-shrink-0">
                      <FiChevronDown size={22} />
                    </span>
                  </summary>
                  <div class="text-text-secondary px-6 pb-6 pt-0 leading-relaxed">
                    {item.desc}
                  </div>
                </details>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Final CTA -->
      <section class="mb-8">
        <div class="relative rounded-[2.5rem] p-10 md:p-16 text-center overflow-hidden bg-bg-surface" style="box-shadow: var(--shadow-neu-float)">
          <div class="aurora-blob w-96 h-96 -top-32 -left-24" style="background: radial-gradient(circle, hsl(var(--grad-start) / 0.25), transparent 60%);"></div>
          <div class="aurora-blob w-96 h-96 -bottom-32 -right-24" style="background: radial-gradient(circle, hsl(var(--grad-end) / 0.22), transparent 60%);"></div>
          <div class="relative">
            <h2 class="font-display font-black text-3xl md:text-5xl leading-tight tracking-tight mb-5">
              {t('commercial:cta.title')}
            </h2>
            <p class="text-lg text-text-secondary mb-10 max-w-2xl mx-auto leading-relaxed">{t('commercial:cta.subtitle')}</p>
            <a href="mailto:support@nyx-app.my.id" class="btn-primary px-10 py-4 text-lg inline-flex">
              <FiMail className="mr-2" /> {t('commercial:cta.button')}
            </a>
          </div>
        </div>
      </section>

      <div class="mt-16">
        <Footer lang={lang} />
      </div>
    </main>
  </div>
</MainLayout>
